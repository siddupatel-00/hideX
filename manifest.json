{
  "manifest_version": 3,
  "name": "hideX",
  "version": "1.0.1",
  "description": "Hide Likes, Replies, Reposts, Quotes & Views, and blur username, badge, avatar & timestamp for a bias-free X/Twitter feed. 100% local, zero network.",
  "minimum_chrome_version": "105",
  "permissions": ["storage"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*"],
  "externally_connectable": {
    "matches": []
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": false,
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_title": "hideX",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
